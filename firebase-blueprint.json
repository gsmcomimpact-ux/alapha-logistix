    "Shipment": {
      "title": "Shipment",
      "description": "Expédition suivie avec position actuelle et affectation client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "trackingCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "clientUid": {
          "type": "string",
          "maxLength": 128
        },
        "clientEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "transportMode": {
          "type": "string",
          "enum": ["Fret maritime", "Fret aérien", "Corridor routier", "Dédouanement & Entreposage"]
        },
        "origin": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "destination": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "cargoDescription": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "weightOrVolume": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "currentLocation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "currentStatus": {
          "type": "string",
          "enum": [
            "Pris en charge",
            "En transit maritime",
            "En transit aérien",
            "Arrivé au port / hub",
            "En dédouanement",
            "En route corridor",
            "Livré"
          ]
        },
        "estimatedArrival": {
          "type": "string",
          "maxLength": 40
        },
        "updatesCount": {
          "type": "integer"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
