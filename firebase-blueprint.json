  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Comptes clients enregistrés (PII protégée)."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/ClientRecord" },
      "description": "Dossiers clients créés et gérés par l'administration."
    },
    "/staffUsers/{staffId}": {
      "schema": { "$ref": "#/entities/StaffUser" },
      "description": "Utilisateurs habilités à la gestion des données (clients, tracking)."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Administrateurs habilités pour la gestion du tracking."
    },
    "/shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/Shipment" },
      "description": "Expéditions actives et archivées avec position actuelle."
    },
    "/shipments/{shipmentId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/TrackingEvent" },
      "description": "Journal chronologique des positions de la marchandise."
    },
    "/shipments/{shipmentId}/documents/{docId}": {
      "schema": { "$ref": "#/entities/ShipmentDocument" },
      "description": "Documents logistiques sécurisés liés à chaque expédition."
    },
    "/clientDocuments/{docId}": {
      "schema": { "$ref": "#/entities/ClientDocument" },
      "description": "Documents logistiques et administratifs associés directement à un client."
    },
    "/quoteRequests/{quoteId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Demandes de cotation et propositions commerciales associées."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/ClientNotification" },
      "description": "Notifications en temps réel relatives aux expéditions et documents clients."
    }
  }
}
