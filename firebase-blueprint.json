{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil client enregistré via e-mail/mot de passe ou Google sur la plateforme Alpha Logistix Group.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["client"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["pending", "validated", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "email", "phone", "company", "city", "role", "createdAt", "updatedAt"]
    },
